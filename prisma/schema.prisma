generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                    @id @default(cuid())
  whatsappId             String?                   @unique
  telegramId             String?                   @unique
  displayName            String?
  createdAt              DateTime                  @default(now())
  emailAccount           EmailAccount?
  emailLogs              EmailLog[]
  expenses               Expense[]
  notificationPreference NotificationPreference?
  pendingEvents          PendingCrossModuleEvent[]
  tasks                  Task[]
  telegramLinkCodes      TelegramLinkCode[]
  oauthAccounts          OAuthAccount[]
  WhatsAppMessage        WhatsAppMessage[]
  Wishlist               Wishlist[]
  pendingReceipts        PendingReceipt[]

  @@map("users")
}

model WebAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("web_accounts")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model EmailAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  provider     String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  emailAddress String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
  @@map("email_accounts")
}

model Expense {
  id         String   @id @default(cuid())
  userId     String
  amount     Decimal
  currency   String   @default("NGN")
  category   String?
  merchant   String?
  source     String
  rawInput   String?
  parsedBy   String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("expenses")
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  priority  String    @default("medium")
  dueAt     DateTime?
  source    String?
  isDone    Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("tasks")
}

model EmailLog {
  id           String   @id @default(cuid())
  userId       String
  subject      String?
  summary      String?
  detectedType String?
  routedTo     String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_logs")
}

model PendingCrossModuleEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  payload   String
  status    String   @default("pending_module")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("pending_cross_module_events")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  leakAlerts         Boolean  @default(true)
  taskReminders      Boolean  @default(true)
  subscriptionAlerts Boolean  @default(true)
  dailyDigest        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model TelegramLinkCode {
  code      String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("telegram_link_codes")
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  userId      String
  messageId   String?  @unique
  direction   String   @default("inbound")
  messageType String
  body        String?
  mediaId     String?
  sentAt      DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, messageType])
  @@map("whatsapp_messages")
}

model Wishlist {
  id             String    @id @default(cuid())
  userId         String
  title          String
  targetAmount   Decimal
  savedAmount    Decimal   @default(0)
  currency       String    @default("NGN")
  priority       String    @default("medium")
  status         String    @default("active")
  remindOnLeak   Boolean   @default(true)
  lastRemindedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("wishlists")
}

model PendingReceipt {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal
  currency  String   @default("NGN")
  merchant  String?
  rawText   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("pending_receipts")
}
